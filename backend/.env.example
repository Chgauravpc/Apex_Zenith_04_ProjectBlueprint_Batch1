# Free-tier keys (https://console.groq.com, https://openrouter.ai)
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Model IDs per task (re-check free model list on build day)
MODEL_TEXT=openai/gpt-oss-120b
MODEL_TEXT_FALLBACK=nvidia/nemotron-3.5-lightning:free
MODEL_VISION=nvidia/nemotron-3.5-super-vl:free
MODEL_VISION_FALLBACK=qwen/qwen3.8-27b
MODEL_STT=whisper-large-v3
DATABASE_URL=sqlite:///./blueprint.db
STORAGE_DIR=storage
FRONTEND_ORIGIN=http://localhost:5173
ERP_BASE_URL=http://localhost:8001

# Embeddings for semantic search: local (needs torch), cloud (Hugging Face API) or off
# (keyword search only). Use cloud on small free hosts such as Render (512 MB).
EMBEDDING_PROVIDER=local
# Free read token from https://huggingface.co/settings/tokens (only for EMBEDDING_PROVIDER=cloud)
HF_API_TOKEN=
EMBEDDING_MODEL=intfloat/multilingual-e5-small
