# Free-tier keys (https://console.groq.com, https://openrouter.ai)
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Model IDs per task (re-check free model list on build day)
MODEL_TEXT=openai/gpt-oss-120b
MODEL_TEXT_FALLBACK=nvidia/nemotron-3.5-lightning:free
MODEL_VISION=nvidia/nemotron-3.5-super-vl:free
MODEL_VISION_FALLBACK=qwen/qwen3.8-27b
MODEL_STT=whisper-large-v3
DATABASE_URL=sqlite:///./blueprint.db
STORAGE_DIR=storage
# local = files only on this disk; supabase = also kept in a private Supabase Storage bucket
# (needed on hosts whose disk is wiped on restart, such as Render free)
STORAGE_BACKEND=local
SUPABASE_URL=
# Server-side secret (Project Settings > API > service_role). Never put it in the frontend.
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=media
# This API's public address when the frontend is on another domain, e.g.
# https://blueprint-api.onrender.com (media links then become absolute)
PUBLIC_BASE_URL=
FRONTEND_ORIGIN=http://localhost:5173
ERP_BASE_URL=http://localhost:8001

# Embeddings for semantic search: cloudflare (Workers AI bge-m3, free plan), local (e5-small,
# needs torch) or off (keyword search only). Use the same provider everywhere: vectors from
# different models cannot be compared, and switching re-embeds every card at startup.
EMBEDDING_PROVIDER=cloudflare
# Cloudflare dashboard: account ID, and an API token with the "Workers AI" permission
CF_ACCOUNT_ID=
CF_API_TOKEN=
